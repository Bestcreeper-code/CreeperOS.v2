#include <stdint.h>

#define SYS_READ        0
#define SYS_WRITE       1
#define SYS_OPEN        2
#define SYS_CLOSE       3
#define SYS_SCHED_YIELD 24
#define SYS_EXIT        61
#define SYS_MKDIR       83
#define SYS_CREAT       85

static long syscall3(long n, long a1, long a2, long a3)
{
    long ret;
    asm volatile(
        "syscall"
        : "=a"(ret)
        : "a"(n), "D"(a1), "S"(a2), "d"(a3)
        : "rcx", "r11", "memory"
    );
    return ret;
}
static long syscall2(long n, long a1, long a2)
{
    long ret;
    asm volatile(
        "syscall"
        : "=a"(ret)
        : "a"(n), "D"(a1), "S"(a2)
        : "rcx", "r11", "memory"
    );
    return ret;
}
static long syscall1(long n, long a1)
{
    long ret;
    asm volatile(
        "syscall"
        : "=a"(ret)
        : "a"(n), "D"(a1)
        : "rcx", "r11", "memory"
    );
    return ret;
}

static char dir[]  = "/tmp/ctest";
static char file[] = "/tmp/ctest/hello.txt";
static char msg[]  = "hello from C userspace syscall test\n";

/* ---- tiny freestanding helpers (no libc available) ---- */

static int u_strlen(const char* s)
{
    int n = 0;
    while (s[n]) n++;
    return n;
}

static void u_write_str(const char* s)
{
    syscall3(SYS_WRITE, 1, (long)s, u_strlen(s));
}

/* prints an unsigned 64-bit value in hex, e.g. 0x1234abcd */
static void u_write_hex(uint64_t v)
{
    char buf[19]; // "0x" + 16 hex digits + '\0'
    const char* hexch = "0123456789abcdef";
    buf[0] = '0';
    buf[1] = 'x';
    for (int i = 0; i < 16; i++)
        buf[2 + i] = hexch[(v >> ((15 - i) * 4)) & 0xF];
    buf[18] = '\0';
    u_write_str(buf);
}

/* prints an unsigned 64-bit value in decimal */
static void u_write_dec(uint64_t v)
{
    char buf[21];
    int i = 20;
    buf[i--] = '\0';
    if (v == 0) {
        buf[i--] = '0';
    } else {
        while (v > 0) {
            buf[i--] = '0' + (v % 10);
            v /= 10;
        }
    }
    u_write_str(&buf[i + 1]);
}

/* ---- argc/argv/envp test ---- */

static void test_args(int argc, char** argv, char** envp)
{
    u_write_str("=== argv/envp test ===\n");

    u_write_str("argc = ");
    u_write_dec((uint64_t)argc);
    u_write_str("\n");

    u_write_str("argv @ ");
    u_write_hex((uint64_t)argv);
    u_write_str("\n");

    for (int i = 0; i < argc; i++) {
        u_write_str("  argv[");
        u_write_dec((uint64_t)i);
        u_write_str("] = ");
        u_write_str(argv[i]);
        u_write_str("\n");
    }
    u_write_str("  argv[");
    u_write_dec((uint64_t)argc);
    u_write_str("] = (nil)\n");

    u_write_str("envp @ ");
    u_write_hex((uint64_t)envp);
    u_write_str("\n");

    int envc = 0;
    if (envp) {
        while (envp[envc]) {
            u_write_str("  envp[");
            u_write_dec((uint64_t)envc);
            u_write_str("] = ");
            u_write_str(envp[envc]);
            u_write_str("\n");
            envc++;
        }
    }
    u_write_str("  envp[");
    u_write_dec((uint64_t)envc);
    u_write_str("] = (nil)\n");

    u_write_str("=== end args test ===\n");
}

void main(int argc, char** argv, char** envp)
{
    long ret;
    int fd;

    test_args(argc, argv, envp);

    // mkdir /tmp/ctest
    ret = syscall2(SYS_MKDIR, (long)dir, 0755);

    // create file
    ret = syscall2(SYS_CREAT, (long)file, 0644);

    // open file
    fd = syscall3(SYS_OPEN, (long)file, 2 /* O_RDWR */, 0);

    if (fd >= 0) {
        syscall3(SYS_WRITE, fd, (long)msg, sizeof(msg) - 1);
        syscall1(SYS_CLOSE, fd);
    } else {
        char buff[4];
        int n = fd < 0 ? -fd : fd;
        buff[0] = fd < 0 ? '-' : '+';
        buff[1] = '0' + (n / 10);
        buff[2] = '0' + (n % 10);
        buff[3] = '\0';
        syscall3(SYS_WRITE, 1, (long)buff, 4);
    }

    // yield once
    asm volatile(
        "mov $24, %%rax\n"
        "syscall\n"
        :
        :
        : "rax", "rcx", "r11"
    );

    // exit but leave files
    syscall1(SYS_EXIT, 0);
    while (1);
}


