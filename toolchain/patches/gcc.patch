diff --git a/gcc/config/creeperos.h b/gcc/config/creeperos.h
new file mode 100644
index 00000000000..62c2ec8fcbe
--- /dev/null
+++ b/gcc/config/creeperos.h
@@ -0,0 +1,47 @@
+/* Target definitions for CreeperOS (x86_64, ELF, mlibc).
+
+   Included last in tm_file (see gcc/config.gcc), so the #undefs below
+   override i386elf.h / elfos.h defaults.  */
+
+/* Predefined macros and assertions.  */
+#undef TARGET_OS_CPP_BUILTINS
+#define TARGET_OS_CPP_BUILTINS()		\
+  do						\
+    {						\
+      builtin_define ("__creeperos__");		\
+      builtin_define ("__unix__");		\
+      builtin_assert ("system=creeperos");	\
+      builtin_assert ("system=unix");		\
+      builtin_assert ("system=posix");		\
+    }						\
+  while (0)
+
+/* Path of the dynamic linker as seen by CreeperOS at run time.
+   Change this to whatever your mlibc port installs (it is the
+   PT_INTERP string baked into every dynamically linked program).  */
+#ifndef CREEPEROS_DYNAMIC_LINKER
+#define CREEPEROS_DYNAMIC_LINKER "/usr/lib/ld.so"
+#endif
+
+/* C library.  mlibc keeps pthreads and libm in separate or the same
+   library depending on your build; add -lm/-lpthread here if needed.  */
+#undef LIB_SPEC
+#define LIB_SPEC "-lc"
+
+/* crt1.o/Scrt1.o come from mlibc; crtbegin*.o and crtend*.o come from
+   libgcc.  crti.o/crtn.o are deliberately not used: mlibc does not build
+   them and --enable-initfini-array makes them unnecessary.  */
+#undef STARTFILE_SPEC
+#define STARTFILE_SPEC \
+  "%{shared:;pie:Scrt1.o%s;:crt1.o%s} " \
+  "%{static:crtbeginT.o%s;shared|pie:crtbeginS.o%s;:crtbegin.o%s}"
+
+#undef ENDFILE_SPEC
+#define ENDFILE_SPEC \
+  "%{shared|pie:crtendS.o%s;:crtend.o%s}"
+
+#undef LINK_SPEC
+#define LINK_SPEC \
+  "%{shared:-shared} %{static:-static} %{pie:-pie} " \
+  "%{!static:%{rdynamic:-export-dynamic} " \
+  "%{!shared:-dynamic-linker " CREEPEROS_DYNAMIC_LINKER "}}"
