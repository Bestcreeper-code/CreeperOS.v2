+  }\n\
+  .data1          : { *(.data1) }\n\
+  _edata = .;\n\
+  PROVIDE (edata = .);\n\
+  . = ALIGN(ALIGNOF(NEXT_SECTION));\n\
+  __bss_start = .;\n\
+  .bss            :\n\
+  {\n\
+    *(.dynbss)\n\
