+static void
+gldelf_x86_64_creeperos_list_options (FILE * file)
+{
+  
+  fprintf (file, _("\
+  -z noextern-protected-data  Do not treat protected data symbol as external\n"));
+  fprintf (file, _("\
+  -z indirect-extern-access   Enable indirect external access\n"));
