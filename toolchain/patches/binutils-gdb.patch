--- /dev/null
+++ b/ld/emulparams/elf_x86_64_creeperos.sh
@@ -0,0 +1,10 @@
+# ld emulation parameters for x86_64-creeperos.
+# Pulls in everything from the stock x86-64 ELF emulation (page sizes,
+# text start 0x400000, ELF templates, SysV ABI defaults) and overrides
+# only what is CreeperOS-specific.
+source_sh ${srcdir}/emulparams/elf_x86_64.sh
+
+# Example overrides -- uncomment/adjust to match your kernel's loader:
+# TEXT_START_ADDR=0x400000        # where your loader maps the first PT_LOAD
+# MAXPAGESIZE="CONSTANT (MAXPAGESIZE)"
+# COMMONPAGESIZE="CONSTANT (COMMONPAGESIZE)"
