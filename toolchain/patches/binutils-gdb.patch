+	fi
+	@if test -d $(HOST_SUBDIR)/libbacktrace; then \
+	  cd $(HOST_SUBDIR); mv libbacktrace stageautofeedback-libbacktrace; \
+	  mv prev-libbacktrace stageautoprofile-libbacktrace; : ; \
