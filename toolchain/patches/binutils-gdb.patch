+  }\n\
+  .ldata   ALIGN(CONSTANT (MAXPAGESIZE)) + (. & (CONSTANT (MAXPAGESIZE) - 1)) :\n\
+  {\n\
+    *(.ldata .ldata.* .gnu.linkonce.l.*)\n\
+      . = ALIGN(. != 0 ? 32 / 8 : 1);\n\
+  }\n\
+  . = ALIGN(32 / 8);\n\
+  _end = .;\n\
+  PROVIDE (end = .);\n\
+  . = DATA_SEGMENT_END (.);\n\
+  /* Start of the Tiny Data region.  */\n\
