+  .stabstr       0 : { *(.stabstr) }\n\
+  .stab.excl     0 : { *(.stab.excl) }\n\
+  .stab.exclstr  0 : { *(.stab.exclstr) }\n\
+  .stab.index    0 : { *(.stab.index) }\n\
+  .stab.indexstr 0 : { *(.stab.indexstr) }\n\
