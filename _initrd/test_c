static void test_cleanup(void)
{
    u_write_str("=== TEST: unlink/rmdir ===\n");

    long rret = syscall1(SYS_RMDIR, (long)dir);
    log_ret("rmdir /tmp/ctest", rret);

    long uret = syscall1(SYS_UNLINK, (long)file);
    log_ret("unlink hello.txt", uret);

    u_write_str("=== END unlink/rmdir ===\n\n");
}

void main(int argc, char** argv, char** envp)
{
    test_args(argc, argv, envp);
    test_getpid();

    test_file_write();
    test_read();
    test_lseek();
    test_brk();
    test_getcwd();
    test_sched_yield();
    //test_fork();
    test_sysfs_input();
    test_devfs_input();

    test_cleanup();

//for(;;);
    u_write_str("=== ALL TESTS DONE ===\n");

    syscall1(SYS_EXIT, 0);
    while (1);
}

