/* ---- fork test ---- */

static void test_fork(void)
{
    u_write_str("=== TEST: fork ===\n");

    long pid = syscall0(SYS_FORK);
    log_ret("fork", pid);

    if (pid == 0) {
        u_write_str("  [child] hello from child, pid = ");
        long mypid = syscall0(SYS_GETPID);
        u_write_dec((uint64_t)mypid);
        u_write_str("\n");
        /* child exits on its own so it doesn't fall through
        into the parent's later cleanup/exit path twice */
        syscall1(SYS_EXIT, 0);
        while (1);
    } else if (pid > 0) {
        u_write_str("  [parent] forked child pid = ");
        u_write_dec((uint64_t)pid);
        u_write_str("\n");
    } else {
        u_write_str("  [parent] fork failed\n");
    }

    u_write_str("=== END fork ===\n\n");
}

/* ---- sysfs input test: read /sys/class/input/input0/{name,id} ---- */

static void test_sysfs_input(void)
{
    u_write_str("=== TEST: sysfs input (name/id) ===\n");

    long fd = syscall3(SYS_OPEN, (long)sysfs_name_path, 0 /* O_RDONLY */, 0);
    log_ret("open /sys/class/input/input0/name", fd);

    if (fd >= 0) {
        char buf[64] = {0};
        long rret = syscall3(SYS_READ, fd, (long)buf, sizeof(buf) - 1);
        log_ret("read name", rret);
        if (rret > 0) {
            u_write_str("  name: ");
            u_write_str(buf);
        }
        long cret = syscall1(SYS_CLOSE, fd);
        log_ret("close name", cret);
    } else {
        u_write_str("  [skip] name: open failed\n");
    }

    fd = syscall3(SYS_OPEN, (long)sysfs_id_path, 0 /* O_RDONLY */, 0);
    log_ret("open /sys/class/input/input0/id", fd);

    if (fd >= 0) {
        char buf[32] = {0};
        long rret = syscall3(SYS_READ, fd, (long)buf, sizeof(buf) - 1);
        log_ret("read id", rret);
        if (rret > 0) {
            u_write_str("  id: ");
            u_write_str(buf);
        }
        long cret = syscall1(SYS_CLOSE, fd);
        log_ret("close id", cret);
    } else {
        u_write_str("  [skip] id: open failed\n");
    }

    u_write_str("=== END sysfs input ===\n\n");
}

/* ---- devfs input test: blocking read from /dev/input/input0 ----
 *
 * ps2_kbd_read() blocks on hlt until a key comes through the ring
 * buffer, so this will sit here waiting for keypresses -- press a
 * few keys on the keyboard to see this test complete.
 */

static void test_devfs_input(void)
{
    u_write_str("=== TEST: devfs input (blocking read) ===\n");

    long fd = syscall3(SYS_OPEN, (long)devfs_kbd_path, 0 /* O_RDONLY */, 0);
    log_ret("open /dev/input/input0", fd);

    if (fd >= 0) {
        u_write_str("  press a few keys...\n");

        char buf[8] = {0};
        long rret = syscall3(SYS_READ, fd, (long)buf, sizeof(buf) - 1);
        log_ret("read /dev/input/input0", rret);

        if (rret > 0) {
            u_write_str("  got: ");
            u_write_str(buf);
            u_write_str("\n");
        }

        long cret = syscall1(SYS_CLOSE, fd);
        log_ret("close /dev/input/input0", cret);
    } else {
        u_write_str("  [skip] devfs input: open failed\n");
    }

    u_write_str("=== END devfs input ===\n\n");
}

